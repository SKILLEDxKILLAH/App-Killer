# Copy to .env and fill in. Only the first line is needed.

# The brain. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# What Bells calls you.
BELLS_OWNER=boss

# Models. Research runs in the background, so it can afford more effort.
BELLS_MODEL=claude-opus-5-5
BELLS_RESEARCH_MODEL=claude-opus-5-5
BELLS_EFFORT=low
BELLS_RESEARCH_EFFORT=high

# Let Bells do a quick web search inside a normal reply (0 to turn off).
BELLS_QUICK_SEARCH=1

# Optional premium voice. Without these she uses your browser's own voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Wikipedia asks API clients to give a contact address (an email or
# a URL). With one set, pictures for reports are looked up on the server;
# without it your browser looks them up when a report is shown.
BELLS_CONTACT=

# Where the server listens. Keep it on 127.0.0.1 unless you know why not:
# anyone who can reach this port can spend your API credit.
HOST=127.0.0.1
PORT=4317
